# ---- Jev (https://docs.ai.hackclub.com/api/jev.html) ----
# Get a key for the Hack Club AI proxy and put it here. Without a key the city still runs on free rule-based logic.
JEV_API_KEY=your-hack-club-ai-key
# JEV_BASE_URL=https://ai.hackclub.com/proxy/v1/jev
# JEV_MODEL=jev-latest          # or jev-preview

# ---- Cost control (Jev bills INPUT tokens only) ----
JEV_MAX_CALLS_PER_HOUR=400
JEV_DAILY_INPUT_TOKEN_BUDGET=600000
JEV_MAX_CONCURRENT=3
JEV_THINK_EVERY_DAYS=3         # how often each citizen asks Jev what they feel/want
JEV_GOV_EVERY_HOURS=12         # regular government decision (simulated hours)
# JEV_PRICE_PER_MTOK=0.1       # only used for the cost estimate shown in the UI

# ---- Reset & post-mortem ----
# ADMIN_TOKEN=choose-a-long-random-secret   # enables POST /api/admin/reset and the "Reset city" button (disabled when empty)
AUTO_RESTART_SECONDS=300       # after everyone died: show the post-mortem, then start a new city (0 = never)
# HC_CHAT_MODEL=qwen/qwen3-32b  # Hack Club AI chat model that writes the post-mortem text (uses JEV_API_KEY)
# REPORT_MIN_INTERVAL_SECONDS=600

# ---- Simulation ----
POPULATION=40
DAY_SECONDS=360                # real seconds per simulated day
SEED=1723
