# ---- LLM (OpenAI-compatibele chat/completions endpoint) ----
# Optie A: Jev (eigen endpoint + token)
LLM_BASE_URL=https://jouw-jev-endpoint.example/v1
LLM_API_KEY=jouw-jev-token
LLM_MODEL=jev
# Optie B: een goedkoop model via OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-2.5-flash-lite
# (alias-namen JEV_ENDPOINT / JEV_TOKEN / JEV_MODEL werken ook)
# Zonder sleutel draait de stad gewoon door op gratis regels ("regel-modus").

# ---- Kostenbeheersing ----
LLM_MAX_CALLS_PER_HOUR=60
LLM_DAILY_TOKEN_BUDGET=400000
LLM_BATCH_SIZE=10          # burgers per request
LLM_THINK_EVERY_DAYS=2     # hoe vaak een burger "echt" met de LLM nadenkt
LLM_GOV_EVERY_HOURS=12     # reguliere overheidsbeslissing (sim-uren)
# LLM_PRICE_IN_PER_MTOK=0.1  # alleen voor de kostenschatting in de UI
# LLM_PRICE_OUT_PER_MTOK=0.4

# ---- Simulatie ----
POPULATION=40
DAY_SECONDS=360            # echte seconden per simulatiedag
SEED=1723
